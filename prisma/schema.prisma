generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Authentication (NextAuth) ───────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("RESIDENT_ASSISTANT")
  hallId        String?

  accounts         Account[]
  sessions         Session[]
  hall             ResidenceHall?      @relation(fields: [hallId], references: [id])
  organizedEvents  Event[]             @relation("EventOrganizer")
  coOrganizedEvents EventCoOrganizer[]
  budgetRequests   BudgetRequest[]
  inspirations     Inspiration[]
  collections      Collection[]
  favorites        Favorite[]
  decorations      Decoration[]
  resources        Resource[]
  vendorReviews    VendorReview[]
  comments         Comment[]
  planningBoards       PlanningBoard[]
  boardMembers         PlanningBoardMember[]
  aiSessions           AIPlannerSession[]
  aiUsages             AIUsage[]
  decorationFavorites  DecorationFavorite[]
  decorationsMade      DecorationMade[]

  polls            Poll[]
  pollVotes        PollVote[]
  incidents        Incident[]
  notes            Note[]
  dutyShifts       DutyShift[]
  feedbacks        Feedback[]
  checkIns         CheckIn[]
  checkInBoards    CheckInBoard[]
  notifications    Notification[]
  residents        Resident[]
  roomChecks       RoomCheckRound[]
  roomCheckBoards  RoomCheckBoard[]
  roomCheckResults RoomCheckResult[]
  tags             Tag[]
  conversations    Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Residence Halls ─────────────────────────────────────────────────────────

model ResidenceHall {
  id          String  @id @default(cuid())
  name        String  @unique
  address     String?
  capacity    Int?
  imageUrl    String?
  description String?

  users   User[]
  events  Event[]
  budgets Budget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Events ──────────────────────────────────────────────────────────────────

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  startTime   DateTime
  endTime     DateTime
  location    String?
  category    String   @default("COMMUNITY_BUILDING")
  status      String   @default("DRAFT")
  reflection  String?
  attendance  Int?
  tagId       String?
  // Weekdays this event repeats on, JSON array of 0-6 (Sun-Sat); null = one-off.
  recurrenceDays String?

  organizerId String
  hallId      String?

  organizer       User              @relation("EventOrganizer", fields: [organizerId], references: [id])
  hall            ResidenceHall?    @relation(fields: [hallId], references: [id])
  tag             Tag?              @relation(fields: [tagId], references: [id], onDelete: SetNull)
  coOrganizers    EventCoOrganizer[]
  photos          EventPhoto[]
  learningOutcomes LearningOutcome[]
  budgetRequest   BudgetRequest?
  comments        Comment[]
  vendors         EventVendor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EventCoOrganizer {
  id      String @id @default(cuid())
  eventId String
  userId  String

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model EventPhoto {
  id       String  @id @default(cuid())
  eventId  String
  url      String
  caption  String?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model LearningOutcome {
  id          String @id @default(cuid())
  eventId     String
  description String

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// ─── Budgets ─────────────────────────────────────────────────────────────────

model Budget {
  id        String @id @default(cuid())
  hallId    String
  semester  String
  allocated Float
  used      Float  @default(0)

  hall     ResidenceHall   @relation(fields: [hallId], references: [id])
  requests BudgetRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hallId, semester])
}

model BudgetRequest {
  id          String  @id @default(cuid())
  eventId     String? @unique
  userId      String
  budgetId    String?
  title       String
  description String?
  amount      Float
  status      String  @default("DRAFT")

  event    Event?       @relation(fields: [eventId], references: [id])
  user     User         @relation(fields: [userId], references: [id])
  budget   Budget?      @relation(fields: [budgetId], references: [id])
  items    BudgetItem[]
  expenses Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BudgetItem {
  id              String  @id @default(cuid())
  budgetRequestId String
  name            String
  quantity        Int     @default(1)
  unitCost        Float
  vendor          String?
  url             String?
  notes           String?

  budgetRequest BudgetRequest @relation(fields: [budgetRequestId], references: [id], onDelete: Cascade)
}

model Expense {
  id              String  @id @default(cuid())
  budgetRequestId String
  description     String
  amount          Float
  receiptUrl      String?
  date            DateTime

  budgetRequest BudgetRequest @relation(fields: [budgetRequestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ─── Inspiration ─────────────────────────────────────────────────────────────

model Inspiration {
  id          String   @id @default(cuid())
  userId      String
  title       String?
  description String?
  source      String   @default("UPLOAD")
  url         String?
  imageUrl    String?
  category    String?
  tags        String?
  /// Private to the RA who saved it unless they choose to share it with the team.
  isPublic    Boolean  @default(false)

  user        User             @relation(fields: [userId], references: [id])
  collections CollectionItem[]
  favorites   Favorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Collection {
  id          String  @id @default(cuid())
  userId      String
  name        String
  description String?
  isPublic    Boolean @default(false)

  user  User             @relation(fields: [userId], references: [id])
  items CollectionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CollectionItem {
  id            String @id @default(cuid())
  collectionId  String
  inspirationId String

  collection  Collection  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  inspiration Inspiration @relation(fields: [inspirationId], references: [id], onDelete: Cascade)

  @@unique([collectionId, inspirationId])
}

model Favorite {
  id            String @id @default(cuid())
  userId        String
  inspirationId String

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  inspiration Inspiration @relation(fields: [inspirationId], references: [id], onDelete: Cascade)

  @@unique([userId, inspirationId])
}

// ─── Decorations ─────────────────────────────────────────────────────────────

model Decoration {
  id           String  @id @default(cuid())
  userId       String
  title        String
  description  String?
  type         String  @default("DOOR_DECORATION")
  category     String  @default("WELCOME_WEEK")
  imageUrl     String?
  fileUrl      String?
  instructions String?
  costEstimate Float?
  favorites    Int     @default(0)

  user        User                 @relation(fields: [userId], references: [id])
  materials   DecorationMaterial[]
  comments    Comment[]
  favoritedBy DecorationFavorite[]
  madeBy      DecorationMade[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DecorationFavorite {
  id           String @id @default(cuid())
  decorationId String
  userId       String

  decoration Decoration @relation(fields: [decorationId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([decorationId, userId])
}

model DecorationMade {
  id           String  @id @default(cuid())
  decorationId String
  userId       String
  imageUrl     String?
  notes        String?

  decoration Decoration @relation(fields: [decorationId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model DecorationMaterial {
  id           String  @id @default(cuid())
  decorationId String
  name         String
  quantity     String?
  cost         Float?
  url          String?

  decoration Decoration @relation(fields: [decorationId], references: [id], onDelete: Cascade)
}

// ─── Vendors ─────────────────────────────────────────────────────────────────

model Vendor {
  id        String  @id @default(cuid())
  name      String
  category  String  @default("OTHER")
  contact   String?
  email     String?
  phone     String?
  website   String?
  notes     String?
  costRange String?

  reviews VendorReview[]
  events  EventVendor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VendorReview {
  id       String  @id @default(cuid())
  vendorId String
  userId   String
  rating   Int
  comment  String?

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model EventVendor {
  id       String  @id @default(cuid())
  eventId  String
  vendorId String
  notes    String?

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([eventId, vendorId])
}

// ─── Resources ───────────────────────────────────────────────────────────────

model Resource {
  id          String  @id @default(cuid())
  userId      String
  title       String
  description String?
  type        String  @default("EVENT_TEMPLATE")
  fileUrl     String?
  externalUrl String?
  tags        String?
  isPublic    Boolean @default(true)
  // Admin must approve a resource before it's visible platform-wide.
  // Column defaults true so pre-existing rows stay visible after the migration;
  // the create route sets it explicitly (admin → true, others → false/pending).
  approved     Boolean @default(true)
  approvedById String?

  user     User      @relation(fields: [userId], references: [id])
  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Collaboration ───────────────────────────────────────────────────────────

model Comment {
  id           String  @id @default(cuid())
  userId       String
  content      String
  eventId      String?
  decorationId String?
  resourceId   String?

  user       User        @relation(fields: [userId], references: [id])
  event      Event?      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  decoration Decoration? @relation(fields: [decorationId], references: [id], onDelete: Cascade)
  resource   Resource?   @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlanningBoard {
  id          String  @id @default(cuid())
  userId      String
  title       String
  description String?

  user    User                  @relation(fields: [userId], references: [id])
  members PlanningBoardMember[]
  items   PlanningBoardItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlanningBoardMember {
  id      String @id @default(cuid())
  boardId String
  userId  String

  board PlanningBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
}

model PlanningBoardItem {
  id      String  @id @default(cuid())
  boardId String
  title   String
  content String?
  type    String
  order   Int     @default(0)

  board PlanningBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Authorization Codes ─────────────────────────────────────────────────────

model AuthorizationCode {
  id        String   @id @default(cuid())
  code      String   @unique
  role      String   @default("RESIDENT_ASSISTANT")
  hallId    String?
  usedBy    String?
  usedAt    DateTime?
  expiresAt DateTime?
  createdAt DateTime @default(now())
}

// ─── AI Planner ──────────────────────────────────────────────────────────────

// A saved AI planning chat (like a ChatGPT conversation thread).
model Conversation {
  id     String @id @default(cuid())
  userId String
  title  String @default("New chat")

  user     User      @relation(fields: [userId], references: [id])
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Message {
  id             String @id @default(cuid())
  conversationId String
  role           String // "user" | "assistant"
  content        String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([conversationId])
}

model AIPlannerSession {
  id         String @id @default(cuid())
  userId     String
  budget     Float
  audience   String
  goal       String
  attendance Int
  response   String

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

// ─── AI Usage Tracking ───────────────────────────────────────────────────────

// Per-user AI planner usage, keyed by day ("YYYY-MM-DD"). Daily windows match
// how provider free-tier quotas reset, and catch bursts a monthly cap misses.
model AIUsage {
  id     String @id @default(cuid())
  userId String
  day    String

  count Int @default(0)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, day])
}

// App-wide AI planner usage for a given day. Guards the shared provider free
// quota: once the whole platform hits GLOBAL_DAILY_LIMIT, generation pauses for
// everyone until the next day rather than erroring out mid-request.
model GlobalAIUsage {
  day   String @id
  count Int    @default(0)
}

// ─── Polls ───────────────────────────────────────────────────────────────────

model Poll {
  id        String  @id @default(cuid())
  userId    String
  question  String
  active    Boolean @default(true)
  options   String

  user  User       @relation(fields: [userId], references: [id])
  votes PollVote[]

  createdAt DateTime @default(now())
}

model PollVote {
  id       String @id @default(cuid())
  pollId   String
  userId   String
  optionId String

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@unique([pollId, userId])
}

// ─── Incidents ───────────────────────────────────────────────────────────────

model Incident {
  id           String  @id @default(cuid())
  userId       String
  date         String
  time         String
  type         String
  severity     String  @default("low")
  location     String
  description  String
  actionTaken  String?
  followUpNeeded Boolean @default(false)
  status       String  @default("open")
  isPublic     Boolean @default(false) // private by default; only an admin may flip this on
  // Sharing needs admin sign-off. The owner asks by setting this to "pending";
  // an admin either flips isPublic and clears it, or sets "rejected" so the
  // owner can see the answer instead of wondering why nothing happened.
  shareRequest String? // null | "pending" | "rejected"

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Notes ───────────────────────────────────────────────────────────────────

model Note {
  id      String  @id @default(cuid())
  userId  String
  title   String
  content String?
  color   String  @default("purple")
  pinned  Boolean @default(false)

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Duty Shifts ─────────────────────────────────────────────────────────────

model DutyShift {
  id     String @id @default(cuid())
  userId String
  date   String
  type   String @default("evening")
  title  String?
  notes  String?
  tagId  String?
  // Shared by every shift created from one repeat, so the whole run can be
  // removed in one go instead of clicking each date on the calendar.
  seriesId String?

  user User @relation(fields: [userId], references: [id])
  tag  Tag? @relation(fields: [tagId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

// User-owned label with a colour. Replaces raw colour pickers on events + duty:
// a tag's name defaults to its colour name but can be renamed. `kind` scopes a
// tag to "event", "duty", or "any".
model Tag {
  id     String @id @default(cuid())
  userId String
  name   String
  color  String // hex, e.g. "#3f6b52"
  kind   String @default("any")

  user   User        @relation(fields: [userId], references: [id])
  events Event[]
  shifts DutyShift[]

  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Feedback ────────────────────────────────────────────────────────────────

model Feedback {
  id        String  @id @default(cuid())
  userId    String?
  mood      String
  category  String?
  message   String
  anonymous Boolean @default(true)

  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

// ─── Check-Ins ───────────────────────────────────────────────────────────────

model CheckIn {
  id           String  @id @default(cuid())
  userId       String
  residentId   String?
  residentName String
  room         String?
  mood         String  @default("good")
  topics       String?
  notes        String?
  followUp     Boolean @default(false)
  boardId      String? // optional check-in board/campaign this belongs to

  user     User          @relation(fields: [userId], references: [id])
  resident Resident?     @relation(fields: [residentId], references: [id], onDelete: SetNull)
  board    CheckInBoard? @relation(fields: [boardId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

// A check-in campaign/context. "shared" boards are created by an admin and
// shown to every RA (each RA checks their own residents, once per resident).
// "personal" boards are private to their owner (once per resident per day).
model CheckInBoard {
  id      String @id @default(cuid())
  title   String
  scope   String @default("personal") // "shared" | "personal"
  ownerId String

  owner    User      @relation(fields: [ownerId], references: [id])
  checkIns CheckIn[]

  createdAt DateTime @default(now())
}

// ─── Notifications ───────────────────────────────────────────────────────────

model Notification {
  id          String  @id @default(cuid())
  userId      String
  type        String
  title       String
  description String
  read        Boolean @default(false)

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

// ─── Floor Residents ─────────────────────────────────────────────────────────

model Resident {
  id        String  @id @default(cuid())
  userId    String
  name      String
  room      String
  floor     String?  // "1", "2", "3"
  wing      String?  // "East", "West", or null (floor 3 = single wing)
  phone     String?
  email     String?
  year      String?
  major     String?
  notes     String?
  flagged   Boolean @default(false)
  moveInDate String?

  user     User      @relation(fields: [userId], references: [id])
  checkIns CheckIn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─── Room Checks ─────────────────────────────────────────────────────────────

model RoomCheckRound {
  id     String @id @default(cuid())
  userId String
  type   String
  rooms  String

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

// A room-check campaign. Created by an admin ("assigned to RAs"); RAs cannot
// create their own. Each RA records one result per resident within a board.
model RoomCheckBoard {
  id      String @id @default(cuid())
  title   String
  type    String @default("Health & Safety")
  ownerId String

  owner   User              @relation(fields: [ownerId], references: [id])
  results RoomCheckResult[]

  createdAt DateTime @default(now())
}

model RoomCheckResult {
  id           String  @id @default(cuid())
  boardId      String
  userId       String
  residentId   String?
  residentName String
  room         String?
  status       String  @default("pass") // pass | concern | absent
  notes        String?

  board RoomCheckBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Generic admin-editable config (JSON value per key). Currently holds the
// incidents page's editable "reporting tracks" + "campus resources" lists.
model Setting {
  key       String   @id
  value     String   // JSON
  updatedAt DateTime @updatedAt @default(now())
}
