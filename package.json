{
  "name": "residence-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "DATABASE_URL=\"file:./dev.db\" npx prisma generate && node scripts/sync-turso.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "npm-check-updates",
    "deps:minor": "npm-check-updates -u --target minor && npm install",
    "deps:update": "npm-check-updates -u && npm install",
    "db:push": "npx prisma db push",
    "db:studio": "npx prisma studio",
    "db:seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
