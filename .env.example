# Database - Local (SQLite file, used when Turso vars are not set)
DATABASE_URL="file:./dev.db"

# Database - Turso (production on Vercel)
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft Entra ID (Azure AD)
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# AWS S3 (for file uploads - optional)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""

# OpenAI (for AI Event Planner)
OPENAI_API_KEY=""
