# Database - Local (SQLite file, used when Turso vars are not set)
DATABASE_URL="file:./dev.db"

# Database - Turso (production on Vercel)
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft Entra ID (Azure AD)
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# Password-reset email (Resend). Both are required for links to be emailed; with
# either one missing, /forgot-password just logs the request and an admin issues
# the link by hand from the Admin page.
RESEND_API_KEY=""
EMAIL_FROM="Residence Hub <noreply@example.com>"

# AWS S3 (for file uploads - optional)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""

# Google Gemini (used by other AI features)
GEMINI_API_KEY=""

# AI Event Planner — set at least one provider key. The planner tries providers
# in order (AI_PROVIDER_ORDER) and falls over between them automatically when one
# errors or hits its rate limit.
# OpenRouter (free-model chain): https://openrouter.ai/keys
OPENROUTER_API_KEY=""
# NVIDIA NIM (OpenAI-compatible): https://build.nvidia.com
NVIDIA_API_KEY=""
# Gemini also powers the planner as a fallback (OpenAI-compatible endpoint).
# GEMINI_API_KEY is declared above.
# Optional provider/model overrides:
# AI_PROVIDER_ORDER="gemini,openrouter,nvidia"
# OPENROUTER_MODELS="nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free"
# NVIDIA_MODELS="z-ai/glm-5.2,nvidia/nemotron-3-ultra-550b-a55b"
# GEMINI_MODELS="gemini-2.5-flash-lite,gemini-2.5-flash"

# AI planner rate limits (all DAILY, reset at server midnight). Two layers:
#   per-user (tiered by role) + a global app-wide cap that guards the shared
#   provider free quota. Tune without a redeploy.
# AI_LIMIT_RA_DAILY="10"          # per RESIDENT_ASSISTANT / day
# AI_LIMIT_RHA_DAILY="5"          # per RHA_MEMBER / day
# AI_LIMIT_DEFAULT_DAILY="5"      # any other non-admin role / day
# AI_LIMIT_ADMIN_DAILY=""         # blank = unlimited for admins
# AI_LIMIT_GLOBAL_DAILY="1000"    # whole platform / day (0 disables)

# Secret Vercel Cron passes as `Authorization: Bearer <CRON_SECRET>` to protect /api/cron/*
CRON_SECRET=""

# ── Database seeding (npm run db:seed) ───────────────────────────────────────
# All optional. Anything left blank is generated randomly and printed once by
# the seed script. NEVER hardcode real credentials here — this file is committed.
SEED_ADMIN_EMAIL="admin@residencehub.com"
SEED_ADMIN_PASSWORD=""            # blank = seed generates & prints one
SEED_RA_CODE=""                   # RESIDENT_ASSISTANT authorization code
SEED_ADMIN_CODE=""                # ADMIN authorization code

# ── E2E tests (Playwright) ───────────────────────────────────────────────────
# The auth setup logs in with these; match them to your seeded admin.
E2E_ADMIN_EMAIL="admin@residencehub.com"
E2E_ADMIN_PASSWORD=""             # required to run e2e; no default in code
